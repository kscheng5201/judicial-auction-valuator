# src/ingestion/judicial_yuan — Judicial Yuan auction crawler

JUDICIAL_YUAN_DB_HOST=localhost
JUDICIAL_YUAN_DB_PORT=3306
JUDICIAL_YUAN_DB_USER=root
JUDICIAL_YUAN_DB_PASS=your_password_here
JUDICIAL_YUAN_DB_NAME=judicial_auctions

JUDICIAL_YUAN_PDF_DIR=./data/raw/judicial_yuan/pdfs

# seconds to wait between HTTP requests (be polite to the server)
JUDICIAL_YUAN_REQUEST_DELAY=0.8
JUDICIAL_YUAN_REQUEST_TIMEOUT=30

# retry/backoff for transient network failures (e.g. no internet yet
# when the scheduled job fires); delay before attempt N is
# RETRY_BASE_DELAY * 2^(N-1) seconds
JUDICIAL_YUAN_RETRY_MAX_ATTEMPTS=4
JUDICIAL_YUAN_RETRY_BASE_DELAY=5

# optional webhook (e.g. Slack incoming webhook URL) for failure alerts;
# a macOS desktop notification is always attempted regardless of this
JUDICIAL_YUAN_ALERT_WEBHOOK_URL=

# upcoming auctions: how many days ahead to query
JUDICIAL_YUAN_UPCOMING_DAYS_AHEAD=90

# historical 拍定價格: how many days back to query (365 = 1 year)
JUDICIAL_YUAN_HISTORICAL_DAYS_BACK=365

# cron schedules (Asia/Taipei), used by scripts/schedule_judicial_yuan_crawler.py
JUDICIAL_YUAN_UPCOMING_CRON=0 13 * * *
JUDICIAL_YUAN_HISTORICAL_CRON=0 12 * * *

# how long (seconds) a missed scheduled fire is still allowed to run late
# (e.g. desktop was asleep/offline) instead of being skipped; default 6h
JUDICIAL_YUAN_MISFIRE_GRACE_SECONDS=21600
