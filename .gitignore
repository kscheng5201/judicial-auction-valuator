# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment
.env
.env.*
!.env.example

# Raw data snapshots — regenerated by running the ingestion scripts,
# not checked in (see docs/DATA_SOURCES.md). Directory layout is kept
# via .gitkeep so ingestion output has a place to land.
data/raw/**/*
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**/*
!data/processed/**/
!data/processed/**/.gitkeep

# Editors / OS
.DS_Store
.idea/
.vscode/
